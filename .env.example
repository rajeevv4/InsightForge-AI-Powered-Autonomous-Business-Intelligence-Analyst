# PostgreSQL Database Configuration for InsightForge (Read-Write)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insightforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=insightforge

# PostgreSQL Read-Only Engine (Level 1 Security Role)
DB_RO_USER=insightforge_ro
DB_RO_PASSWORD=insightforge_ro_pass

# Offline / Fixture Mode (Rule 5: NO silent fake data)
# Set to 1 to allow canonical fixture fallbacks when PostgreSQL is offline (demo/testing mode)
# Set to 0 (default) to require live PostgreSQL database connection
USE_FIXTURES=0

# AI Configuration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API Rate Limiting
RATE_LIMIT_AI_ASK=30/minute
